{
	"name": "nightshift",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.18.0",
			"libsql": "0.5.29",
			"@orpc/server": "^1.15.0",
			"@orpc/openapi": "^1.15.0",
			"@orpc/zod": "^1.15.0",
			"better-auth": "1.7.12",
			"@better-auth/api-key": "1.7.12",
			"@better-auth/core": "1.7.12",
			"@better-auth/drizzle-adapter": "1.7.12",
			"@better-auth/expo": "1.7.12",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "19.3.0",
			"react-dom": "19.3.0",
			"react-native": "0.88.0",
			"uniwind": "^1.13.0",
			"react-native-reanimated": "4.7.1",
			"react-native-worklets": "0.13.0",
			"react-native-svg": "15.16.0",
			"react-native-safe-area-context": "~5.10.1",
			"lucide-react-native": "^1.61.0",
			"@rn-primitives/portal": "^1.5.3",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.3",
			"@orpc/client": "^1.15.0",
			"@orpc/tanstack-query": "^1.15.0",
			"@tanstack/react-query": "^5.102.8",
			"@tanstack/react-form": "^1.33.5",
			"@types/react": "~19.3.0",
			"@types/react-dom": "^19.2.7",
			"drizzle-orm": "1.0.0-rc.4",
			"yjs": "^13.6.33",
			"y-protocols": "^1.0.7"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"night": "bun scripts/night.ts",
		"build": "turbo run build --filter='!desktop' && turbo run build -F desktop",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:mobile": "turbo run dev -F mobile --",
		"dev:desktop": "turbo run dev:hmr -F desktop --",
		"build:desktop": "turbo run build:stable -F desktop --",
		"build:desktop:canary": "turbo run build:canary -F desktop --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @nightshift/db --",
		"db:studio": "turbo run db:studio -F @nightshift/db --",
		"db:generate": "turbo run db:generate -F @nightshift/db --",
		"db:migrate": "turbo run db:migrate -F @nightshift/db --",
		"db:local": "turbo run db:local -F @nightshift/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/mobile/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/mobile/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"check": "biome check --write .",
		"data:migrate": "bun run --cwd apps/server data:migrate"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@nightshift/config": "workspace:*",
		"@types/bun": "catalog:",
		"lefthook": "^2.1.12",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.3.10"
}
