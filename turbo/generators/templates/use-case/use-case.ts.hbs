import type { Actor } from "{{{actorFromApplication}}}";
{{{accessImport}}}

export type {{{useCasePascal}}}Ports = {
	access: {{{accessType}}};
};

/** Which Space the request is for. */
export type {{{useCasePascal}}} = { spaceId: string };

/**
 * {{{useCaseAbout}}}
 *
 * Refuses an actor who may not act in the Space, before anything else
 * (`access.openSpace` throws the `Refusal`).
 */
export const {{{useCaseCamel}}} =
	(ports: {{{useCasePascal}}}Ports) =>
	async (actor: Actor, request: {{{useCasePascal}}}): Promise<void> => {
		await ports.access.openSpace(actor, { spaceId: request.spaceId });
	};
