import { describe, expect, test } from "bun:test";
import { allowing } from "{{{accessFromApplication}}}/adapters/out/in-memory-access";
import { inMemory{{{slicePascal}}}Ports } from "../adapters/out/in-memory-neighbours";
import { {{{useCaseCamel}}} } from "./{{{useCase}}}";

/** The use case {{{useCaseCamel}}}, on in-memory adapters. */

const SPACE = "space-1";

describe("{{{useCaseCamel}}}", () => {
	test("every Member of the Space may, and nobody else", async () => {
		const ports = inMemory{{{slicePascal}}}Ports();
		expect(
			await ports.access.whoMay(SPACE, (actor) =>
				{{{useCaseCamel}}}(ports)(actor, { spaceId: SPACE }),
			),
		).toEqual(allowing("owner", "admin", "member", "viewer"));
	});

	test("answers a Member", async () => {
		const ports = inMemory{{{slicePascal}}}Ports();
		const viewer = ports.access.as("viewer", SPACE);
		expect(await {{{useCaseCamel}}}(ports)(viewer, { spaceId: SPACE })).toBeUndefined();
	});
});
