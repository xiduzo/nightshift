import type { Actor } from "{{{actorFromAdapters}}}";
import type { {{{slicePascal}}}Access } from "../../application/ports";

/**
 * The in-memory adapters of the ports that another slice or package
 * fills (`@filledBy` in `application/ports.ts`), and
 * `inMemory{{{slicePascal}}}Ports`, which gives a use-case test every port of
 * the slice at once. Test code: production code never imports this file.
 */

/** Who may act in the Spaces of a test: everyone, until the test refuses Persons. */
export type InMemory{{{slicePascal}}}Access = {{{slicePascal}}}Access & {
	/** Every Space that was opened, and for whom, in order. */
	opened: { actor: Actor; spaceId: string }[];
	/** From now on `openSpace` throws this for an actor that is a Person. */
	refuse(error: unknown): void;
};

export function inMemory{{{slicePascal}}}Access(): InMemory{{{slicePascal}}}Access {
	let refusal: { error: unknown } | null = null;
	const access: InMemory{{{slicePascal}}}Access = {
		opened: [],
		refuse: (error) => {
			refusal = { error };
		},
		async openSpace(actor, request) {
			access.opened.push({ actor, ...request });
			if (refusal && "personId" in actor) throw refusal.error;
		},
	};
	return access;
}

/** Every port of {{{slice}}} in memory at once: where each use-case test starts. */
export function inMemory{{{slicePascal}}}Ports() {
	return {
		access: inMemory{{{slicePascal}}}Access(),
	};
}
