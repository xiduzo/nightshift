{
	"expo": {
		"name": "Night Shift",
		"slug": "nightshift",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "nightshift",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "dev.nightshift.mobile",
			"entitlements": {
				"com.apple.developer.usernotifications.time-sensitive": true
			},
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#0a0a0a",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "dev.nightshift.mobile",
			"permissions": [
				"android.permission.POST_NOTIFICATIONS",
				"android.permission.USE_BIOMETRIC",
				"android.permission.USE_FINGERPRINT",
				"android.permission.CAMERA"
			]
		},
		"web": {
			"bundler": "metro",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-notifications",
				{
					"enableBackgroundRemoteNotifications": true,
					"defaultChannel": "gates",
					"color": "#0a0a0a"
				}
			],
			[
				"expo-local-authentication",
				{
					"faceIDPermission": "Night Shift asks for Face ID before it sends your answer to a Gate."
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Night Shift uses the camera to scan the code of your Host.",
					"microphonePermission": false,
					"recordAudioAndroid": false
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"image": "./assets/images/splash-icon-dark.png",
						"backgroundColor": "#0a0a0a"
					}
				}
			],
			[
				"expo-widgets",
				{
					"bundleIdentifier": "dev.nightshift.mobile.widgets",
					"groupIdentifier": "group.dev.nightshift.mobile",
					"enableAndroid": true,
					"enablePushNotifications": false,
					"widgets": [
						{
							"name": "NightShiftGlance",
							"displayName": "Night Shift",
							"description": "See how many Gates wait for you and the status of your latest runs.",
							"ios": {
								"supportedFamilies": [
									"systemSmall",
									"systemMedium",
									"accessoryRectangular",
									"accessoryInline"
								]
							},
							"android": {
								"targetCellWidth": 3,
								"targetCellHeight": 2,
								"resizeMode": "both"
							}
						}
					]
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {
				"asyncRoutes": {
					"web": true
				}
			},
			"eas": {
				"build": {
					"experimental": {
						"ios": {
							"appExtensions": [
								{
									"targetName": "ExpoWidgetsTarget",
									"bundleIdentifier": "dev.nightshift.mobile.widgets",
									"entitlements": {
										"com.apple.security.application-groups": [
											"group.dev.nightshift.mobile"
										]
									}
								}
							]
						}
					}
				},
				"projectId": "61f0dd73-7856-4392-9f90-3464f62df875"
			}
		},
		"owner": "xiduzo"
	}
}
