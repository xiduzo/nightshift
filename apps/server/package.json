{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -b ../../packages/api && tsdown",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"build:binary": "bun scripts/build-binary.ts",
		"dev": "NIGHTSHIFT_DEV=true bun run --hot src/index.ts",
		"test": "bun test",
		"start": "bun run dist/index.mjs",
		"data:migrate": "bun src/data-migrate.ts",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
		"join": "bun src/join-cli.ts",
		"nightshift": "bun src/cli.ts"
	},
	"dependencies": {
		"@hocuspocus/provider": "^4.7.1",
		"@hocuspocus/server": "^4.7.1",
		"@nightshift/agents": "workspace:*",
		"@nightshift/api": "workspace:*",
		"@nightshift/auth": "workspace:*",
		"@nightshift/db": "workspace:*",
		"@nightshift/engine": "workspace:*",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"hono": "^4.13.7",
		"libsql": "catalog:",
		"varlock": "catalog:",
		"y-protocols": "catalog:",
		"yjs": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nightshift/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
