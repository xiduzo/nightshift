{
	"name": "server",
	"type": "module",
	"scripts": {
		"build": "tsc -b ../../packages/api && tsdown",
		"check-types": "tsc -b ../../packages/api && tsc --noEmit",
		"build:binary": "bun scripts/build-binary.ts",
		"dev": "NIGHTSHIFT_DEV=true bun run --hot --preload ./src/hot-preload.ts src/main.ts",
		"test": "bun test",
		"start": "bun run dist/main.mjs",
		"data:migrate": "bun src/features/cli/data-migrate.ts",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/auth-config.ts --output ../../packages/db/src/schema/auth.ts --yes",
		"join": "bun src/join-cli.ts",
		"nightshift": "bun src/cli.ts"
	},
	"dependencies": {
		"@nightshift/agents": "workspace:*",
		"@nightshift/api": "workspace:*",
		"@nightshift/auth": "workspace:*",
		"@nightshift/daemon": "workspace:*",
		"@nightshift/db": "workspace:*",
		"@nightshift/flows": "workspace:*",
		"@nightshift/time": "workspace:*",
		"@orpc/client": "catalog:",
		"better-auth": "catalog:",
		"libsql": "catalog:",
		"varlock": "catalog:"
	},
	"devDependencies": {
		"@hocuspocus/provider": "^4.7.1",
		"@nightshift/config": "workspace:*",
		"@nightshift/engine": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:",
		"yjs": "catalog:"
	}
}
