# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Root for transcripts and other on-disk state. Defaults to ~/.nightshift.
# @optional @sensitive=false
NIGHTSHIFT_DATA_DIR=

# Every NIGHTSHIFT_* value below is a fallback: a value saved on the Settings
# or Agents page wins. NIGHTSHIFT_SCHEDULER=off is the one exception.

# The `claude` executable for Claude Code Agent and Decision nodes. Defaults to
# `claude` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_CLAUDE_BIN=

# The `opencode` executable for OpenCode Agent nodes. Defaults to `opencode` on
# the PATH. It must be a 1.x build: @tanstack/ai-opencode 0.5 cannot drive the
# 2.x server (see docs/PLAN.md §7).
# @optional @sensitive=false
NIGHTSHIFT_OPENCODE_BIN=

# The `codex` executable for Codex Agent nodes. Defaults to `codex` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_CODEX_BIN=

# The `gh` executable for the GitHub tools and For Each sources. Defaults to
# `gh` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_GH_BIN=

# How many runs may run a step at once. Defaults to 2.
# @optional @sensitive=false
NIGHTSHIFT_MAX_CONCURRENT_RUNS=

# The most steps one run may take, unless its flow sets maxSteps. Defaults to 500.
# @optional @sensitive=false
NIGHTSHIFT_MAX_STEPS_PER_RUN=

# "off": this daemon starts no scheduled runs, whatever the Settings page says.
# Set it for a dev daemon, so only the night daemon (`bun run night`) starts them.
# @optional @sensitive=false
NIGHTSHIFT_SCHEDULER=

# "off": a run the daemon stopped mid-step waits for a person after a restart,
# instead of continuing on its own. Defaults to on (only with the scheduler on).
# @optional @sensitive=false
NIGHTSHIFT_RESUME_INTERRUPTED_RUNS=
