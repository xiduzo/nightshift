# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# The database. Defaults to nightshift.db in the data directory. Set it only
# for a database somewhere else, for example a libsql server: libsql://….
# @optional
DATABASE_URL=

# The data directory: the database, the transcripts and the command logs of
# this daemon. Defaults to the app data directory of the OS:
# ~/Library/Application Support/Night Shift on macOS,
# $XDG_DATA_HOME/nightshift (else ~/.local/share/nightshift) on Linux,
# %APPDATA%\Night Shift on Windows. Two daemons never share one.
# @optional @sensitive=false
NIGHTSHIFT_DATA_DIR=

# Set by `bun run dev`: the data directory defaults to .nightshift-dev/ in this
# checkout instead, so a dev daemon keeps out of the night's data.
# @optional @sensitive=false
NIGHTSHIFT_DEV=

# Every NIGHTSHIFT_* value below is a fallback: a value saved on the Settings
# or Agents page wins. NIGHTSHIFT_SCHEDULER=off is the one exception.

# The `claude` executable for Claude Code Agent and Decision nodes. Defaults to
# `claude` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_CLAUDE_BIN=

# The `opencode` executable for OpenCode Agent nodes. Defaults to `opencode` on
# the PATH. It must be a 1.x build: @tanstack/ai-opencode 0.5 cannot drive the
# 2.x server (see docs/PLAN.md §7).
# @optional @sensitive=false
NIGHTSHIFT_OPENCODE_BIN=

# The `codex` executable for Codex Agent nodes. Defaults to `codex` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_CODEX_BIN=

# The `grok` executable for Grok Build Agent nodes. Defaults to `grok` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_GROK_BIN=

# The `copilot` executable for GitHub Copilot Agent nodes. Defaults to
# `copilot` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_COPILOT_BIN=

# The `gemini` executable for Gemini CLI Agent nodes. Defaults to `gemini` on
# the PATH.
# @optional @sensitive=false
NIGHTSHIFT_GEMINI_BIN=

# The Cursor CLI (`agent`) for Cursor Agent nodes. Defaults to `agent` on the
# PATH.
# @optional @sensitive=false
NIGHTSHIFT_CURSOR_BIN=

# How many runs may run a step at once. Defaults to 2.
# @optional @sensitive=false
NIGHTSHIFT_MAX_CONCURRENT_RUNS=

# The most steps one run may take, unless its flow sets maxSteps. Defaults to 500.
# @optional @sensitive=false
NIGHTSHIFT_MAX_STEPS_PER_RUN=

# "off": this daemon starts no scheduled runs, whatever the Settings page says.
# Set it for a dev daemon, so only the night daemon (`bun run night`) starts them.
# @optional @sensitive=false
NIGHTSHIFT_SCHEDULER=

# "off": a run the daemon stopped mid-step waits for a person after a restart,
# instead of continuing on its own. Defaults to on (only with the scheduler on).
# @optional @sensitive=false
NIGHTSHIFT_RESUME_INTERRUPTED_RUNS=
