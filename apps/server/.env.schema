# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Root for transcripts and other on-disk state. Defaults to ~/.nightshift.
# @optional @sensitive=false
NIGHTSHIFT_DATA_DIR=

# The `opencode` executable for OpenCode Agent nodes. Defaults to `opencode` on
# the PATH. It must be a 1.x build: @tanstack/ai-opencode 0.5 cannot drive the
# 2.x server (see docs/PLAN.md §7).
# @optional @sensitive=false
NIGHTSHIFT_OPENCODE_BIN=

# The `codex` executable for Codex Agent nodes. Defaults to `codex` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_CODEX_BIN=

# "off": this daemon starts no scheduled runs. Set it for a dev daemon, so only
# the night daemon (`bun run night`) starts them.
# @optional @sensitive=false
NIGHTSHIFT_SCHEDULER=
