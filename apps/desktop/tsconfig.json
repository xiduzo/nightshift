{
	"extends": [
		"../../packages/config/tsconfig.base.json",
		"./.hutch/devkit/tsconfig.json"
	],
	"compilerOptions": {
		// `electrobun prepare` writes `baseUrl` into the devkit config. TypeScript 7
		// removed the option. Its `paths` resolve from that file without it.
		"baseUrl": null,
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"types": ["bun"]
	},
	"include": ["src/**/*.ts", "electrobun.config.ts"]
}
