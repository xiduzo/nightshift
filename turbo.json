{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", "artifacts/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:hmr": {
			"cache": false,
			"persistent": true
		},
		"build:stable": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["artifacts/**", "build/**"],
			"env": ["NIGHTSHIFT_VERSION", "NIGHTSHIFT_UPDATE_FEED"],
			"passThroughEnv": [
				"ELECTROBUN_DEVELOPER_ID",
				"ELECTROBUN_TEAMID",
				"ELECTROBUN_APPLEID",
				"ELECTROBUN_APPLEIDPASS",
				"ELECTROBUN_APPLEAPIKEY",
				"ELECTROBUN_APPLEAPIISSUER",
				"ELECTROBUN_APPLEAPIKEYPATH"
			]
		},
		"build:canary": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["artifacts/**", "build/**"],
			"env": ["NIGHTSHIFT_VERSION", "NIGHTSHIFT_UPDATE_FEED"],
			"passThroughEnv": [
				"ELECTROBUN_DEVELOPER_ID",
				"ELECTROBUN_TEAMID",
				"ELECTROBUN_APPLEID",
				"ELECTROBUN_APPLEIDPASS",
				"ELECTROBUN_APPLEAPIKEY",
				"ELECTROBUN_APPLEAPIISSUER",
				"ELECTROBUN_APPLEAPIKEYPATH"
			]
		},
		"db:push": {
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:local": {
			"cache": false,
			"persistent": true
		}
	},
	"globalEnv": [
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"CORS_ORIGIN",
		"DATABASE_URL",
		"NODE_ENV",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"VERCEL_URL",
		"VITE_SERVER_URL",
		"_VARLOCK_ENV_KEY"
	],
	"globalPassThroughEnv": ["NIGHTSHIFT_DATA_DIR", "XDG_DATA_HOME"],
	"globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
