{
	"name": "@nightshift/db",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./data-dir": "./src/data-dir/index.ts",
		"./migrate": "./src/migrate/index.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"check-types": "tsc -b",
		"test": "bun test",
		"db:local": "turso dev --db-file local.db",
		"db:push": "NIGHTSHIFT_DEV=true drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:deploy": "drizzle-kit migrate",
		"db:studio": "NIGHTSHIFT_DEV=true drizzle-kit studio",
		"db:migrate": "NIGHTSHIFT_DEV=true drizzle-kit migrate"
	},
	"dependencies": {
		"@libsql/client": "0.18.0",
		"drizzle-orm": "catalog:",
		"libsql": "catalog:"
	},
	"devDependencies": {
		"@nightshift/config": "workspace:*",
		"drizzle-kit": "1.0.0-rc.4",
		"typescript": "catalog:",
		"varlock": "catalog:"
	}
}
