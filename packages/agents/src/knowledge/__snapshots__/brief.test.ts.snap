exports[`what an agent is told about the knowledge the tools and the report field, as a harness offers them 1`] = `
{
  "env": {
    "NS_KNOWLEDGE": "/data/knowledge/p1",
  },
  "indexIntro": "Night Shift writes this file. One line per file: its path, title, first sentence and the day it last changed. PDF and Word files too. Under the line of a large markdown file: its headings. Read a file, or grep the folder, for more.",
  "report": {
    "additionalProperties": false,
    "properties": {
      "learnings": {
        "description": "Optional. Short notes about this project that would help the next agent. Leave it out when you have none.",
        "items": {
          "type": "string",
        },
        "maxItems": 10,
        "type": "array",
      },
      "outcome": {
        "description": ""pass": the task is done. "fail": it is not. "needs-input": a person must decide or provide something.",
        "enum": [
          "pass",
          "fail",
          "needs-input",
        ],
        "type": "string",
      },
      "summary": {
        "description": "One or two sentences about the result.",
        "type": "string",
      },
    },
    "required": [
      "outcome",
      "summary",
    ],
    "type": "object",
  },
  "terminal": "search_knowledge finds files in the project's knowledge by keyword, and by meaning when this computer can: the wiki, pages and notes besides the code. read_knowledge reads one of them, and each file is a resource too. The tools work in the project of the folder you work in, or the one you name in \`project\` (list_projects).",
  "tools": [
    {
      "description": "Search the project's knowledge: the files besides the code that agents read, such as a wiki, web pages, work items, PDF and Word files. It finds by keyword, and also by meaning when this computer can, so a question in other words finds an answer too. Returns the best files first, each with its path, title, the section (its heading and line, and page for a PDF) and an excerpt with the words found in bold. Every word must match, else some of them. Keep a phrase together in quotes. End a word with * to match its start. Read a file with read_knowledge: give it the hit's section, page or line to read from there.",
      "inputSchema": {
        "properties": {
          "limit": {
            "description": "At most this many files. Default 10, at most 50.",
            "type": "number",
          },
          "query": {
            "description": "The words to look for. Example: deploy "release notes" config*",
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "search_knowledge",
    },
    {
      "description": "Read one file of the project's knowledge by its path, as search_knowledge gives it. Returns its text, at most 100 KB: from the start, or from the section, page or line of a search hit when you give them. For a PDF or Word file, the text in it.",
      "inputSchema": {
        "properties": {
          "line": {
            "description": "Start at this line, from search_knowledge: of the file, or of the page you give.",
            "type": "number",
          },
          "page": {
            "description": "Start at this page of a PDF, from search_knowledge.",
            "type": "number",
          },
          "path": {
            "description": "The file's path in the knowledge, from search_knowledge. Example: wiki/Home.md",
            "type": "string",
          },
          "section": {
            "description": "Start at this section: its heading, as search_knowledge gives it. Example: Rolling updates",
            "type": "string",
          },
        },
        "required": [
          "path",
        ],
        "type": "object",
      },
      "name": "read_knowledge",
    },
  ],
}
`;
