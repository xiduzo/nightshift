											"!@nightshift/flows",
											"!@nightshift/flows/files",
											"!@nightshift/ui/components/*",
											"!@nightshift/ui/hooks/*",
											"!@nightshift/ui/lib/*",
											"!@nightshift/ui/globals.css",
											"!@nightshift/client",
											"!@nightshift/notifications",
											"!@nightshift/notifications/testing",
											"!@nightshift/notifications/contract",
											"!@nightshift/ui-native/components/ui/*",
											"!@nightshift/ui-native/hooks/*",
											"!@nightshift/ui-native/lib/*",
											"!@nightshift/ui-native/global.css"
