											"@nightshift/agents/**",
											"@nightshift/auth",
											"@nightshift/auth/**",
											"@nightshift/db",
											"@nightshift/db/**",
											"@nightshift/devices",
											"@nightshift/devices/**",
											"@nightshift/engine",
											"@nightshift/engine/**",
											"@nightshift/api",
											"@nightshift/api/context",
											"@nightshift/flows/files",
											"@nightshift/notifications",
