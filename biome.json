{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/.next",
			"!**/dist",
			"!**/.turbo",
			"!**/.hutch",
			"!**/.cache",
			"!**/.nx",
			"!**/dev-dist",
			"!**/.zed",
			"!**/.vscode",
			"!**/routeTree.gen.ts",
			"!**/src-tauri",
			"!**/.nuxt",
			"!bts.jsonc",
			"!**/.expo",
			"!**/uniwind-types.d.ts",
			"!**/.wrangler",
			"!**/.alchemy",
			"!**/.svelte-kit",
			"!**/wrangler.jsonc",
			"!**/.source",
			"!**/convex/_generated",
			"!apps/*/src/env.ts",
			"!packages/*/src/env.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "info",
				"noUndeclaredDependencies": "error"
			},
			"suspicious": {
				"noImportCycles": "error"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			},
			"style": {
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"noUnusedTemplateLiteral": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"@nightshift/**",
									"!@nightshift/agents",
									"!@nightshift/agents/harness-facts",
									"!@nightshift/agents/mcp",
									"!@nightshift/agents/pricing",
									"!@nightshift/agents/types",
									"!@nightshift/agents/testing",
									"!@nightshift/api",
									"!@nightshift/api/client",
									"!@nightshift/api/context",
									"!@nightshift/auth",
									"!@nightshift/auth/testing",
									"!@nightshift/db",
									"!@nightshift/db/schema",
									"!@nightshift/db/data-dir",
									"!@nightshift/db/migrate",
									"!@nightshift/engine",
									"!@nightshift/daemon",
									"!@nightshift/daemon/heartbeat",
									"!@nightshift/devices",
									"!@nightshift/engine/testing",
									"!@nightshift/flows",
									"!@nightshift/flows/files",
									"!@nightshift/ui/components/*",
									"!@nightshift/ui/hooks/*",
									"!@nightshift/ui/lib/*",
									"!@nightshift/ui/globals.css",
									"!@nightshift/client",
									"!@nightshift/notifications",
									"!@nightshift/notifications/testing",
									"!@nightshift/notifications/contract",
									"!@nightshift/ui-native/components/ui/*",
									"!@nightshift/ui-native/hooks/*",
									"!@nightshift/ui-native/lib/*",
									"!@nightshift/ui-native/global.css"
								],
								"message": "Import a package by an entry in its package.json exports, never a path inside it (see docs/steering/STRUCTURE.md, section 3)."
							},
							{
								"group": [
									"server",
									"server/**",
									"desktop",
									"desktop/**",
									"web",
									"web/**",
									"mobile",
									"mobile/**"
								],
								"message": "No workspace imports an app (see docs/steering/STRUCTURE.md, section 1)."
							},
							{
								"group": ["**/packages/**", "**/apps/*/src/**"],
								"message": "Never reach into another workspace by a relative path. Import the package by its name and a listed entry."
							},
							{
								"group": ["@nightshift/*/testing"],
								"message": "./testing holds fakes and test helpers. Only tests import it."
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/ui/src/components/**",
				"packages/ui-native/src/components/**"
			],
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/test-support.ts",
				"**/test-daemons.ts",
				"**/testing/**",
